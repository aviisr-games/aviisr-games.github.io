<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ninely engine source (aviisr-games/Ninely at the pack's sourceCommit). Override with -p:NinelyEngineDir=... -->
    <NinelyEngineDir Condition="'$(NinelyEngineDir)' == ''">/Volumes/MacMiniDev/projects/Ninely-latest/Assets/_Project/Scripts/SudokuEngine</NinelyEngineDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(NinelyEngineDir)/*.cs" />
  </ItemGroup>
</Project>
